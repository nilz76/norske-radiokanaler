{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Norske radiokanaler",
  "type": "object",
  "required": [
    "updated",
    "stations"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Dato lista sist ble endret"
    },
    "stations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/station"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "station": {
      "type": "object",
      "required": [
        "id",
        "name",
        "broadcaster",
        "region",
        "homepage",
        "source",
        "streams"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "description": "Fast kanalnummer, brukt som tvg-chno i spillelistene"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "broadcaster": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "description": "\"Riksdekkende\", eller ett av de 15 fylkene",
          "enum": [
            "Riksdekkende",
            "Agder",
            "Akershus",
            "Buskerud",
            "Finnmark",
            "Innlandet",
            "Møre og Romsdal",
            "Nordland",
            "Oslo",
            "Rogaland",
            "Telemark",
            "Troms",
            "Trøndelag",
            "Vestfold",
            "Vestland",
            "Østfold"
          ]
        },
        "area": {
          "type": "string",
          "minLength": 1,
          "description": "Lokalt dekningsområde når det er smalere enn fylket, f.eks. \"Volda og Ørsta\""
        },
        "district": {
          "type": "string",
          "minLength": 1,
          "description": "NRK sitt eget distriktsnavn. Brukes av refresh_nrk.py til å slå opp kanal-slugen på lyd.nrk.no, og er ikke alltid et fylke — Hordaland og Sogn og Fjordane ligger begge i Vestland."
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "source": {
          "type": "string",
          "format": "uri",
          "description": "Siden strøm-URL-ene er hentet fra"
        },
        "note": {
          "type": "string"
        },
        "streams": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "mp3_high": {
              "$ref": "#/$defs/streamUrl"
            },
            "mp3_low": {
              "$ref": "#/$defs/streamUrl"
            },
            "aac_high": {
              "$ref": "#/$defs/streamUrl"
            },
            "aac_low": {
              "$ref": "#/$defs/streamUrl"
            }
          }
        },
        "offair": {
          "type": "boolean",
          "description": "true når kanalen er kjent av lufta. Icecast fjerner mount-punktet når kilden kobler fra, så en deltidssendende lokalradio svarer 404 uten å være nedlagt. check_streams.py rapporterer slike for seg og lar dem ikke feile jobben."
        }
      },
      "additionalProperties": false
    },
    "streamUrl": {
      "type": "string",
      "pattern": "^https?://"
    }
  }
}
