{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Norske radiokanaler",
  "type": "object",
  "required": ["updated", "stations"],
  "properties": {
    "$schema": { "type": "string" },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Dato lista sist ble endret"
    },
    "stations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/station" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "station": {
      "type": "object",
      "required": ["id", "name", "broadcaster", "region", "homepage", "source", "streams"],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "description": "Fast kanalnummer, brukt som tvg-chno i spillelistene"
        },
        "name": { "type": "string", "minLength": 1 },
        "broadcaster": { "type": "string", "minLength": 1 },
        "region": {
          "type": "string",
          "minLength": 1,
          "description": "\"Riksdekkende\" eller distriktsnavn"
        },
        "homepage": { "type": "string", "format": "uri" },
        "source": {
          "type": "string",
          "format": "uri",
          "description": "Siden strøm-URL-ene er hentet fra"
        },
        "note": { "type": "string" },
        "streams": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "mp3_high": { "$ref": "#/$defs/streamUrl" },
            "mp3_low": { "$ref": "#/$defs/streamUrl" },
            "aac_high": { "$ref": "#/$defs/streamUrl" },
            "aac_low": { "$ref": "#/$defs/streamUrl" }
          }
        }
      },
      "additionalProperties": false
    },
    "streamUrl": {
      "type": "string",
      "pattern": "^https?://"
    }
  }
}
